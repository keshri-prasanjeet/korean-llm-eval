{
  "concurrency": 1,
  "max_attempts": 1,
  "timeout_seconds": 300,
  "retry_backoff_seconds": 2,
  "dataset_files": [
    "../data/dataset.json"
  ],
  "models": [
    {
      "name": "anthropic",
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "api_key_env": "ANTHROPIC_API_KEY",
      "parameters": {
        "max_output_tokens": 2048
      }
    }
  ],
  "output_dir": "../outputs/claude-sonnet-5-5"
}
